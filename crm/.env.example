# พอร์ตที่ใช้รันเซิร์ฟเวอร์
PORT=4000

# ----- แจ้งเตือน/รายงานผ่านอีเมล (ไม่ตั้งค่าก็ใช้งานได้ แต่จะไม่ส่งอีเมลจริง แค่บันทึกไว้ในระบบ) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_FROM_EMAIL=crm@example.com
REPORT_TO_EMAILS=sales1@example.com,manager@example.com

# เวลาที่จะส่งรายงานประจำวันอัตโนมัติ (cron, ค่าเริ่มต้น = ทุกวัน 08:00 เวลาไทย)
DAILY_REPORT_CRON=0 8 * * *
TZ=Asia/Bangkok

# จำนวนวันล่วงหน้าที่จะเตือนใบเสนอราคาใกล้หมดอายุ / วันจัดส่งใกล้ถึง
QUOTATION_EXPIRY_WARN_DAYS=3
DELIVERY_WARN_DAYS=2

# ----- AI วิเคราะห์ลูกค้า (Claude API) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ----- ซิงก์ข้อมูลสินค้าจาก Google Sheet "Master Data Sales" (แท็บ "SKU ส่งออก") -----
# สร้าง Service Account บน Google Cloud, เปิด Google Sheets API,
# แล้วแชร์ไฟล์ Google Sheet ให้กับอีเมลของ service account (สิทธิ์ผู้ดู)
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
GOOGLE_SHEET_ID=1aZ3wp-9dU1jNoQ-FVpA9uKNNOYJSSEGmL8IjZXU_40w
GOOGLE_SHEET_TAB=SKU ส่งออก
GOOGLE_SHEET_RANGE=A1:M500
SKU_SYNC_CRON=0 6 * * *
